# Environment variables for Khua Achip Backend API

# Optional API Key for future LLM integration (e.g. Anthropic Claude API)
# In production on Cloudflare Workers, set this secret via:
#   npx wrangler secret put AI_API_KEY
# Or for local development, copy this file to .env and set the value:
AI_API_KEY=

# Allowed CORS origins (comma-separated or * for wildcard)
CORS_ORIGIN=*

# Port for local server (default: 8787)
PORT=8787
